#!/usr/bin/env python3
"""issue -- consolidated issue-management CLI (v3.0.0).

One binary dispatches `issue <verb>` to a per-verb handler discovered from
``lib/cli/``. The three-tier surface (design
``docs/design/cli-consolidation.md`` section 2a):

  - Tier 1 routine verbs live top-level (`issue show`, `issue create`, ...).
  - `issue history <subverb>`  -- read-only git archaeology.
  - `issue admin <subverb>`    -- maintenance / scaffolding / distribution.

Bare `issue` and `issue --help` print the curated tiered help (NOT the
board); `issue <verb> -h` prints that verb's own flags. Global flags
(`--store`, `--json`, `--version`) are defined once in ``lib/cli/common.py``
and attached by each verb that accepts them.

The data path is untouched: this entrypoint only routes arguments to the
same ``lib/*.py`` the flat binaries called (design section 3).
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "lib"))

import cli  # noqa: E402
from cli import common  # noqa: E402

HISTORY_SUMMARY = "read-only git archaeology over the issue store"
ADMIN_SUMMARY = "maintenance, scaffolding, and distribution"


def _signpost_line(label, summary, mods):
    verbs = ", ".join(m.VERB for m in mods) if mods else "(none yet)"
    return f"  {label:<9} {summary}\n              {verbs}"


def build_tiered_help(groups) -> str:
    """Curated tiered help built from the discovered verb metadata.

    Grows automatically as verb modules land: Tier-1 verbs list under
    "routine work"; the history/admin sub-namespaces are two signpost
    lines whose subverbs stay deferred until the agent descends.
    """
    out = []
    out.append("issue -- consolidated issue-management CLI")
    out.append("")
    out.append("usage: issue <verb> [args]        (issue <verb> -h for a verb's flags)")
    out.append("")

    tier1 = groups["tier1"]
    if tier1:
        width = max(len(m.VERB) for m in tier1)
        out.append("routine work:")
        for m in tier1:
            out.append(f"  {m.VERB:<{width}}  {m.SUMMARY}")
        out.append("")

    out.append("more (sub-namespaces -- run `issue <name> -h`):")
    out.append(_signpost_line("history", HISTORY_SUMMARY, groups["history"]))
    out.append(_signpost_line("admin", ADMIN_SUMMARY, groups["admin"]))
    out.append("")
    out.append("global: --store ROOT   --json          version: issue --version")
    return "\n".join(out) + "\n"


def _help_runner(parser):
    def _run(_args):
        parser.print_help()
        return 0
    return _run


def build_parser(groups):
    """Assemble the top parser plus the history/admin sub-namespace routers.

    Returns (parser, history_parser, admin_parser). Verb modules register
    themselves onto the relevant subparsers action; a sub-namespace with no
    subverb prints its own help (exit 0).
    """
    parser = argparse.ArgumentParser(prog="issue", add_help=False)
    sub = parser.add_subparsers(dest="_verb", metavar="<verb>")

    for m in groups["tier1"]:
        m.register(sub)

    history = sub.add_parser(
        "history", add_help=True, help=HISTORY_SUMMARY, description=HISTORY_SUMMARY
    )
    history_sub = history.add_subparsers(dest="_subverb", metavar="<subverb>")
    for m in groups["history"]:
        m.register(history_sub)
    history.set_defaults(_run=_help_runner(history))

    admin = sub.add_parser(
        "admin", add_help=True, help=ADMIN_SUMMARY, description=ADMIN_SUMMARY
    )
    admin_sub = admin.add_subparsers(dest="_subverb", metavar="<subverb>")
    for m in groups["admin"]:
        m.register(admin_sub)
    admin.set_defaults(_run=_help_runner(admin))

    return parser, history, admin


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    groups = cli.discover()

    # Curated help / version / bare invocation are intercepted before
    # argparse so the tiered help replaces argparse's flat subcommand dump.
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(build_tiered_help(groups))
        return 0
    if argv[0] == "--version":
        print(common.VERSION)
        return 0

    parser, _history, _admin = build_parser(groups)
    args = parser.parse_args(argv)

    run = getattr(args, "_run", None)
    if run is None:
        # No verb resolved (should be unreachable: argparse rejects unknown
        # verbs with exit 2). Fall back to the tiered help.
        sys.stdout.write(build_tiered_help(groups))
        return 0
    return run(args)


if __name__ == "__main__":
    sys.exit(main())
