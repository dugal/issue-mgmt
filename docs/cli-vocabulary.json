  "unenforced": [
    {
      "clause": "surface.self-naming",
      "enforced_by": "SelfNamingTests in tests/test_cli_surface.py",
      "note": "IM-239 keyed it on each verb's PROG declaration; a second implementation would be a second authority on one rule."
    },
    {
      "clause": "surface.explicit-output-mode",
      "enforced_by": "the manifest's generation_fields / record_fields plus tests/test_surface_ambient_fields.py",
      "note": "IM-262 measures each declaration against the verb's real --json output."
    },
    {
      "clause": "surface.stability",
      "enforced_by": "the manifest diff test, plus this registry's transitional records",
      "issues": [
        "IM-247",
        "IM-270"
      ],
      "note": "The synonym-window half is recorded here (every transitional spelling names its introducing release and owning issue); wiring the manifest-with-the-commit discipline is IM-247."
    },
    {
      "clause": "surface.structured-errors",
      "enforced_by": "the manifest's per-verb structured_errors ratchet (IM-245)",
      "issues": [
        "IM-260"
      ],
      "note": "A payload ratchet over error paths, not a vocabulary question; IM-254 rejected waiving it and IM-260 owns the conversion."
