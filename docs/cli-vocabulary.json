{
  "class_contract": {
    "all": [
      "--help",
      "--version",
      "--json"
    ],
    "by_class": {
      "mutating": [
        "--lock-timeout",
        "--no-reindex"
      ]
    },
    "exemptions": [
      {
        "flag": "--no-reindex",
        "reason": "This verb IS the index regenerator; a flag suppressing its own work would name nothing.",
        "verb": "issue admin reindex"
      },
      {
        "flag": "--lock-timeout",
        "reason": "Takes the INDEX lock, not a per-issue write lock, so it has no per-issue acquisition to bound. Under IM-242 ('the name follows the lock') a bound here would be a third concept, which nothing has asked for.",
        "verb": "issue admin reindex"
      },
      {
        "flag": "--lock-timeout",
        "reason": "The catchup sweep takes only the store-wide commit lock, bounded by --commit-timeout.",
        "verb": "issue admin snapshot"
      },
      {
        "flag": "--no-reindex",
        "reason": "The sweep commits pending store state and runs no index regeneration of its own.",
        "verb": "issue admin snapshot"
      },
      {
        "flag": "--no-reindex",
        "reason": "Migration's index write is part of its two-commit contract (IM-054), not an optional post-step.",
        "verb": "issue admin migrate"
      }
    ],
    "note": "The `--store` column of surface.verb-class-contract is checked against the four-valued `store` declaration by IM-245 in tests/test_cli_surface.py, not here -- one authority per rule."
  },
